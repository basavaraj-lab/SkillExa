# Environment Configuration for SkillExa FastAPI Backend
APP_NAME=SkillExa Backend API
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api

# Database (PostgreSQL URL; falls back to SQLite if PostgreSQL is not active)
DATABASE_URL=sqlite:///./skillexa.db
# PostgreSQL Example: postgresql://postgres:postgres@localhost:5432/skillexa

# JWT Security
JWT_SECRET=skillexa_super_secret_jwt_key_development_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["*"]

# File Storage
STORAGE_LOCAL_DIR=./uploads
MAX_PDF_SIZE_MB=25

# Code Execution Sandbox
SANDBOX_EXECUTION_TIMEOUT_SECONDS=5
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_MAX_PROCESSES=10

# Video Calling / WebRTC Signaling
WEBRTC_SIGNALING_ENABLED=True

# AI Mock Interview Engine
AI_PROVIDER=auto
AI_DEFAULT_QUESTIONS_COUNT=5
AI_MAX_QUESTIONS_COUNT=15
# Optional external provider credentials (system uses high-quality built-in educational engine if unset)
GEMINI_API_KEY=
OPENAI_API_KEY=
WIKIPEDIA_INTEGRATION_ENABLED=True
